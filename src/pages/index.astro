---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Art from "../components/Art.astro";
import ExperienceRow from "../components/ExperienceRow.astro";
import site from "../data/site";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).filter((p) => !p.data.draft || true);
const featured = projects.filter((p) => p.data.featured);
const rest = projects
  .filter((p) => !p.data.featured)
  .sort((a, b) => Number(a.data.draft) - Number(b.data.draft));
const ordered = [...featured, ...rest];

const experience = await getCollection("experience");

// Marquee items (duplicated for a seamless loop)
const marquee = [...site.focus, "Raspberry Pi", "PostgreSQL", "GitHub Actions", "APIs"];
const marqueeTrack = [...marquee, ...marquee, ...marquee, ...marquee];
---

<Base>
  <Nav />

  <main id="top">
    <!-- ═══════════════ HERO ═══════════════ -->
    <section class="relative overflow-hidden border-b border-line">
      <div class="ruled-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl gap-12 px-5 pb-20 pt-16 sm:px-8 md:grid-cols-12 md:pb-28 md:pt-24">
        <div class="md:col-span-8" data-reveal>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-ink-soft">
            // {site.role}
          </p>
          <h1 class="mt-5 font-display text-[13vw] font-extrabold leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">
            {site.name.split(" ")[0]}
            <span class="block text-ink-soft">
              {site.name.split(" ").slice(1).join(" ")}
            </span>
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft">
            {site.tagline.split("—")[0]}
            <span class="font-medium text-ink">— {site.tagline.split("—").slice(1).join("—")}</span>
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href="#contact"
              class="rounded-full bg-ink px-6 py-3 font-mono text-xs uppercase tracking-wider text-volt transition-transform hover:-translate-y-0.5"
            >
              Start a conversation
            </a>
            {site.socials.github && (
              <a
                href={site.socials.github}
                target="_blank"
                rel="noreferrer"
                class="rounded-full border border-ink/25 px-6 py-3 font-mono text-xs uppercase tracking-wider transition-colors hover:border-ink hover:bg-ink/5"
              >
                GitHub ↗
              </a>
            )}
          </div>
        </div>

        <aside class="md:col-span-4 md:pt-2" data-reveal>
          <div class="border border-line bg-paper-2/70 p-5 font-mono text-xs leading-relaxed">
            <dl class="space-y-3">
              <div class="flex justify-between gap-4">
                <dt class="text-ink-soft">location</dt>
                <dd class="text-right">{site.location}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-ink-soft">status</dt>
                <dd class="text-right">Open to select projects</dd>
              </div>
              <div class="border-t border-line pt-3">
                <dt class="mb-2 text-ink-soft">currently</dt>
                <dd>{site.currently}</dd>
              </div>
              <div class="border-t border-line pt-3">
                <dt class="mb-2 text-ink-soft">learning</dt>
                <dd>{site.learning}</dd>
              </div>
              <div class="border-t border-line pt-3">
                <dt class="mb-2 text-ink-soft">focus</dt>
                <dd class="flex flex-wrap gap-1.5">
                  {site.focus.map((f) => (
                    <span class="border border-ink/20 px-1.5 py-0.5">{f}</span>
                  ))}
                </dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>

      <!-- marquee -->
      <div class="relative border-t border-line bg-ink py-3 text-volt" aria-hidden="true">
        <div class="flex w-max marquee-track">
          {marqueeTrack.map((m) => (
            <span class="flex items-center gap-6 pr-6 font-mono text-[11px] uppercase tracking-[0.2em]">
              {m} <span class="text-volt/50">✦</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════ WORK ═══════════════ -->
    <section id="work" class="mx-auto max-w-6xl scroll-mt-16 px-5 py-20 sm:px-8 md:py-28">
      <div data-reveal class="mb-12 flex items-baseline justify-between gap-6">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
          01 <span class="font-normal text-ink-soft">/</span> Selected work
        </h2>
        <p class="hidden font-mono text-xs text-ink-soft sm:block">files: ~/work</p>
      </div>

      <div class="space-y-16">
        {ordered.map((p, i) => (
          <article id={p.id} data-reveal class="grid gap-8 border-t border-line pt-10 md:grid-cols-12">
            <div class="md:col-span-7">
              <div class="flex flex-wrap items-center gap-3">
                <span class="ghost-index font-display text-5xl font-extrabold">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
                  {p.data.title}
                </h3>
                {p.data.draft && <span class="draft-chip" title="Placeholder content — replace before publishing">Draft</span>}
              </div>
              {p.data.role && (
                <p class="mt-2 font-mono text-xs uppercase tracking-[0.18em] text-ink-soft">
                  {p.data.role}
                </p>
              )}
              <p class="mt-4 max-w-xl leading-relaxed text-ink-soft">{p.data.summary}</p>

              <div class="mt-5 flex flex-wrap gap-2">
                {p.data.stack.map((t) => (
                  <span class="rounded-full bg-ink/5 px-3 py-1 font-mono text-[11px] text-ink-2">{t}</span>
                ))}
              </div>

              <div class="mt-6 flex flex-wrap gap-5 font-mono text-xs">
                <span class="text-ink-soft">{p.data.year}</span>
                {p.data.live && (
                  <a href={p.data.live} target="_blank" rel="noreferrer" class="link-dotted">
                    Live ↗
                  </a>
                )}
                {p.data.repo && (
                  <a href={p.data.repo} target="_blank" rel="noreferrer" class="link-dotted">
                    Source ↗
                  </a>
                )}
              </div>
            </div>

            <div class="md:col-span-5">
              <Art variant={p.data.art} label={p.data.title} />
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════ ABOUT ═══════════════ -->
    <section id="about" class="scroll-mt-16 border-y border-line bg-paper-2/50">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 md:grid-cols-12 md:py-28">
        <div class="md:col-span-5" data-reveal>
          <h2 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
            02 <span class="font-normal text-ink-soft">/</span> About
          </h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-ink-soft md:col-span-7" data-reveal>
          <!-- [EDIT] Replace the about paragraphs with your real story -->
          <p>
            I&rsquo;m a developer and data engineer with several years of
            mostly-Python experience — the kind who enjoys the whole arc: turning
            a messy data problem into a model, a model into an API, and an API
            into something people actually pay for.
          </p>
          <p>
            My main product is <a href="https://cfb-predictor.com" target="_blank" rel="noreferrer" class="font-medium text-ink underline decoration-volt-deep decoration-2 underline-offset-2">cfb-predictor.com</a>,
            a college football margin predictor I built end to end — model,
            Django app, and paid season pass. Lately I&rsquo;ve been working with
            AI agents and tooling, and learning Blender and Unreal on the side
            because 3D work is the most fun I&rsquo;ve had in years.
          </p>
          <p>
            Outside code: <span class="marker">I like a problem that has a number attached to it</span> —
            pick a metric, make it move, prove it moved.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════ EXPERIENCE ═══════════════ -->
    <section id="experience" class="mx-auto max-w-6xl scroll-mt-16 px-5 py-20 sm:px-8 md:py-28">
      <div data-reveal class="mb-12">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">
          03 <span class="font-normal text-ink-soft">/</span> Experience
        </h2>
        <p class="mt-3 font-mono text-xs text-ink-soft">
          <!-- [EDIT] Add real roles as markdown in src/content/experience/ -->
          Roles below are editable drafts.
        </p>
      </div>

      <div class="relative space-y-12 border-l border-ink/15 pl-8">
        {experience
          .slice()
          .sort((a, b) => Number(a.data.draft) - Number(b.data.draft))
          .map((e) => (
            <div data-reveal>
              <ExperienceRow data={e.data} draft={e.data.draft} />
            </div>
          ))}
      </div>
    </section>

    <!-- ═══════════════ CONTACT ═══════════════ -->
    <section id="contact" class="scroll-mt-16 bg-ink text-paper">
      <div class="mx-auto max-w-6xl px-5 py-20 text-center sm:px-8 md:py-28">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-volt" data-reveal>
          04 / Contact
        </p>
        <h2 class="mx-auto mt-5 max-w-3xl font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-6xl" data-reveal>
          Have a project or a role in mind?
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-paper/70" data-reveal>
          My inbox is open — tell me what you&rsquo;re building, and I&rsquo;ll tell you
          honestly whether I&rsquo;m the right fit.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal>
          <a
            href={`mailto:${site.email}`}
            class="rounded-full bg-volt px-8 py-3.5 font-mono text-xs uppercase tracking-wider text-ink transition-transform hover:-translate-y-0.5"
          >
            {site.email}
          </a>
          {site.socials.github && (
            <a
              href={site.socials.github}
              target="_blank"
              rel="noreferrer"
              class="rounded-full border border-paper/30 px-8 py-3.5 font-mono text-xs uppercase tracking-wider transition-colors hover:border-volt hover:text-volt"
            >
              GitHub
            </a>
          )}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
