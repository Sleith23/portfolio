---
import site from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-5 py-8 sm:flex-row sm:items-center sm:px-8">
    <p class="font-mono text-xs text-ink-soft">
      © {year} {site.name} · Built with Astro + Tailwind v4
    </p>
    <div class="flex items-center gap-5 font-mono text-xs text-ink-soft">
      {site.socials.github && (
        <a href={site.socials.github} target="_blank" rel="noreferrer" class="link-dotted">GitHub</a>
      )}
      {site.socials.linkedin && (
        <a href={site.socials.linkedin} target="_blank" rel="noreferrer" class="link-dotted">LinkedIn</a>
      )}
      <a href={`mailto:${site.email}`} class="link-dotted">{site.email}</a>
    </div>
  </div>
</footer>
